                    }
                },
                "AccountAlias": {
                    "target": "com.amazonaws.iam#accountAliasType",
                    "traits": {
                        "smithy.api#documentation": "<p>The account alias to assign to the account.</p>\n         <p>This parameter allows (through its <a href=\"http://wikipedia.org/wiki/regex\">regex pattern</a>) a string of characters consisting of \n    lowercase letters, digits, and dashes. You cannot start or finish with a dash, nor can you have \n    two dashes in a row.</p>"
                    }
                }
            },
            "traits": {
                "smithy.api#input": {}
