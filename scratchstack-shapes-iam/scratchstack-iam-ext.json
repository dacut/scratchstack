                "AccountId": {
                    "target": "com.amazonaws.iam#accountIdType",
                    "traits": {
                        "smithy.api#documentation": "<p>The unique identifier for this account. This is usually omitted; the service will select a random unused account id, but this can be used to specify a particular account id to create.</p><p>The account id must be a 12-digit number.</p>"
